{
  "name": "departify-crm",
  "version": "0.1.0",
  "private": true,
  "description": "DEPARTIFY CRM — operational CRM, multi-tenant, embeddable. Customer Zero: DEPARTIFY.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=@departify-crm/db build && pnpm -r --filter=@departify-crm/shared build && pnpm -r --filter=@departify-crm/api build && pnpm -r --filter=@departify-crm/web build",
    "dev:api": "pnpm --filter=@departify-crm/api dev",
    "dev:web": "pnpm --filter=@departify-crm/web dev",
    "dev:db": "pnpm --filter=@departify-crm/db studio",
    "db:generate": "pnpm --filter=@departify-crm/db generate",
    "db:migrate": "pnpm --filter=@departify-crm/db migrate",
    "db:seed": "pnpm --filter=@departify-crm/db seed",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter=@departify-crm/api test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "prepare": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.0.0"
}
