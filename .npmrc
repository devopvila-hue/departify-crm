# DEPARTIFY CRM — project-level pnpm config
#
# pnpm 11 ignores install scripts by default. We opt-in to specific
# packages that genuinely need them: argon2 (native binding for
# password hashing) and esbuild (binary used by Vite and tsc).
#
# The corresponding entry in the root package.json under
# `pnpm.onlyBuiltDependencies` is also kept in sync for tools that
# read package.json instead of .npmrc.
only-built-dependencies[]=argon2
only-built-dependencies[]=esbuild
