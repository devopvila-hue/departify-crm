# ─── Runtime ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ─── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/departify_crm

# ─── Sessions / encryption ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-me-with-32-bytes-base64
# Used to encrypt provider credentials at rest (separate from session).
ENCRYPTION_KEY=replace-me-with-32-bytes-base64

# ─── Email (Phase 5) — leave empty in dev ──────────────────────────────
# RESEND_API_KEY=
# BREVO_API_KEY=
# EMAIL_WEBHOOK_BASE_URL=http://localhost:4000

# ─── Rate limiting ─────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT_MAX=300
RATE_LIMIT_DEFAULT_WINDOW=1 minute
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=1 minute

# ─── Sprint 5: email / sequences ───────────────────────────────────────
# Secret used to sign unsubscribe links. Rotate periodically.
UNSUB_SECRET=replace-me-with-32-bytes-base64
# Public hostname used to build unsubscribe URLs in outgoing emails.
PUBLIC_HOSTNAME=departify-crm-production.up.railway.app

# ─── OAuth: Google Workspace y Microsoft 365 ──────────────────────────
# Registro de la app en Azure Portal → Entra ID → App registrations.
# Redirect URI (web): https://<tu-host>/api/v1/auth/oauth/microsoft/callback
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT_ID=common   # 'common' para cuentas multi-tenant
# MICROSOFT_OAUTH_REDIRECT_URI=https://<tu-host>/api/v1/auth/oauth/microsoft/callback

# ─── Sprint 6: LLM client (Anthropic-compatible, works with MiniMax) ──
# Define LLM_API_KEY to enable /api/v1/llm/chat and MCP-backed AI features.
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_BASE_URL=https://api.minimax.io/v1
# LLM_MODEL=MiniMax-M3
# LLM_TIMEOUT_MS=60000
# LLM_MAX_RETRIES=2
